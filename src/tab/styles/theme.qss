/*
 * The single source of styling for tab. Widgets are targeted by objectName (#name).
 *
 * Palette: black and bone, with tan and baby blue.
 *   black      #0A0A0A   window background
 *   surface    #0F1012   dial face, inputs, switcher panel, callout cards (near-black stone)
 *   depth      #1B1C1F   selection band, lit timer control, hover, borders (charcoal)
 *   divider    #2B2D31   the switcher panel's edge; outlines on unlit controls (slate)
 *   muted      #8C8E92   secondary text, minor markings, unlit icons (stone grey)
 *   bone       #F5F1F1   primary text, major markings, control icons
 *   tan        #B89A72   primary accent: dial hands and arc, selected icons and phase, focus rings,
 *                        checked fills, values being edited
 *   baby blue  #89CFF0   secondary accent: section headings (callout card titles), and the
 *                        "i" buttons under the mouse. Cool against tan's warmth, so headings
 *                        and values never read as the same thing.
 *   red        #E5484D   destructive actions only (outline and text of buttons that erase data)
 *   green      #3DD68C   completing a session only (the ✓ buttons' outline and icon on hover)
 *
 * Contrast rule: tan is ~7.5:1 on black, so it works as lines and as fills. Baby blue is ~11:1.
 * Text on a tan fill is black.
 */

/* Only the window is painted black (the launch page sits on it). Everything else stays
   transparent so the main screen's graffiti wall (widgets/background.py) shows through;
   widgets that need a solid fill (dial face, inputs, panels, lit controls) set their own. */
QMainWindow {
    background-color: #0A0A0A;
}

QWidget {
    color: #F5F1F1;
    font-family: "Helvetica Neue", "Inter", sans-serif;
    font-size: 14px;
}

QLabel {
    background-color: transparent;
}

/* Splash */

#splash_screen {
    qproperty-lineColor: #F5F1F1;
}

/* Tab switcher (Tab key) and the Profile corner button */

#tab_switcher_panel {
    background-color: #0F1012;
    border: 1px solid #2B2D31;
    border-radius: 16px;
}

#tab_switcher_tile {
    background-color: transparent;
    border: none;
    border-radius: 10px;
    padding: 16px;
    qproperty-iconColor: #8C8E92;
    qproperty-hoverIconColor: #8C8E92;
    qproperty-selectedIconColor: #B89A72;
    qproperty-disabledIconColor: #2B2D31;
}

#tab_switcher_tile:checked {
    background-color: #1B1C1F;
}

#profile_corner_button {
    background-color: transparent;
    border: 1px solid transparent; /* reserves the focus ring's width, so focus doesn't shift it */
    border-radius: 8px;
    padding: 8px;
    qproperty-iconColor: #8C8E92;
    qproperty-hoverIconColor: #8C8E92;
    qproperty-selectedIconColor: #B89A72;
    qproperty-disabledIconColor: #2B2D31;
}

#profile_corner_button:hover {
    background-color: #1B1C1F;
}

/* The "i" beside the Timer's and Duration's clocks: styled like the Profile corner button. */
#info_button {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 8px;
    qproperty-iconColor: #8C8E92;
    qproperty-hoverIconColor: #89CFF0; /* baby blue, like Settings' headings */
    qproperty-selectedIconColor: #B89A72;
    qproperty-disabledIconColor: #2B2D31;
}

#info_button:hover {
    background-color: #1B1C1F;
}

/* The short read it opens (widgets/info_article.py) */
#info_article_dialog {
    background-color: #0F1012;
    qproperty-headingColor: #89CFF0;
}

#info_article {
    background-color: transparent;
    border: none;
    font-size: 15px;
    selection-background-color: #B89A72;
    selection-color: #0A0A0A;
}

#info_article QScrollBar:vertical {
    background: transparent;
    width: 8px;
}

#info_article QScrollBar::handle:vertical {
    background: #2B2D31;
    border-radius: 4px;
    min-height: 32px;
}

#info_article QScrollBar::add-line:vertical,
#info_article QScrollBar::sub-line:vertical {
    height: 0;
}

/* Views */

/* Callout cards (widgets/callout_card.py), shared by Settings and Profile: one card per group.
   Bold bone text and a baby blue title; values (duration drums, profile stats) in tan. */
#callout_card {
    background-color: #0F1012;
    border: 1px solid #2B2D31;
    border-radius: 16px;
}

#callout_card QLabel,
#callout_card QCheckBox {
    font-weight: 600;
}

/* Two ids, so these outrank "#callout_card QLabel" (an id plus a type) above. */
#callout_card #callout_card_title {
    color: #89CFF0;
    font-size: 16px;
    font-weight: 700;
}

/* A grey note nested under the row it explains, like "Since: 11/09/2026". */
#callout_card #callout_card_hint {
    color: #8C8E92;
    font-size: 12px;
    font-weight: 400;
}

#callout_card #duration_picker_separator {
    color: #B89A72;
    font-size: 22px;
    font-weight: 700;
}

#chronograph_dial {
    qproperty-faceColor: #0F1012;
    qproperty-subdialColor: #0A0A0A;
    qproperty-markingColor: #F5F1F1;
    qproperty-minorMarkingColor: #8C8E92;
    qproperty-accentColor: #B89A72;
}

#rotary_picker {
    qproperty-selectedTextColor: #B89A72;
    qproperty-unselectedTextColor: #8C8E92;
    qproperty-selectionBandColor: #1B1C1F;
}

/* Shortcuts page: keys as small keycaps, in the controls' outline style */
#callout_card #shortcut_keycap {
    color: #F5F1F1;
    background-color: #0A0A0A;
    border: 1px solid #2B2D31;
    border-radius: 6px;
    padding: 2px 7px;
    font-family: "DejaVu Sans Mono", "Courier New", monospace;
    font-size: 12px;
    font-weight: 600;
}

#callout_card #shortcut_keycap_separator {
    color: #8C8E92;
    font-weight: 400;
}

/* Settings' Shortcuts button: its own square card beside the Shortcuts title card */
#settings_shortcuts_button {
    background-color: #0F1012;
    border: 1px solid #2B2D31;
    border-radius: 16px;
    padding: 0px;
    qproperty-iconColor: #8C8E92;
    qproperty-hoverIconColor: #89CFF0;
    qproperty-selectedIconColor: #B89A72;
    qproperty-disabledIconColor: #2B2D31;
}

#settings_shortcuts_button:hover {
    background-color: #1B1C1F;
}

/* Phase-end toast, used only when the OS has no tray for desktop notifications */
#in_window_notification_label {
    background-color: #0F1012;
    border: 1px solid #2B2D31;
    border-radius: 12px;
    padding: 12px 20px;
    font-size: 16px;
}

/* Duration view's knot: dots shaded from far (dim tan) to near (tan), so crossings read. */
#duration_knot {
    qproperty-nearColor: #B89A72;
    qproperty-farColor: #4A3E2E;
}

#timer_countdown_label,
#duration_elapsed_label {
    font-family: "DejaVu Sans Mono", "Courier New", monospace;
    font-size: 40px;
}

#callout_card #profile_stat_value {
    color: #B89A72;
    font-size: 18px;
    font-weight: 700;
}

/* Controls */

QPushButton {
    background-color: transparent;
    color: #F5F1F1;
    border: 1px solid #1B1C1F;
    border-radius: 14px;
    padding: 6px 20px;
}

QPushButton:hover {
    border-color: #8C8E92;
}

QPushButton:pressed {
    background-color: #1B1C1F;
}

/* Timer controls. Lit (checked) = like the phase wheel's selection band, with a tan icon.
   Start/Pause stay lit to show whether the timer runs; Reset only flashes when pressed. */

#timer_control_button {
    background-color: transparent;
    border: 1px solid #2B2D31;
    border-radius: 10px;
    padding: 9px 0;
    qproperty-iconColor: #8C8E92;
    qproperty-hoverIconColor: #8C8E92;
    qproperty-selectedIconColor: #B89A72;
    qproperty-disabledIconColor: #2B2D31;
}

#timer_control_button:hover {
    border-color: #8C8E92;
}

#timer_control_button:checked,
#timer_control_button:pressed {
    background-color: #1B1C1F;
    border-color: #1B1C1F;
}

/* The ✓ buttons (Timer's complete session, Duration's Finish): the same hover as the other
   controls, in green. More specific than :focus below, so hovering a focused ✓ stays green. */
#timer_control_button[controlRole="complete_session"]:hover:enabled {
    border-color: #3DD68C;
}

/* …and their ✓ turns green with it (no pseudo-state: qproperties apply once) */
#timer_control_button[controlRole="complete_session"] {
    qproperty-hoverIconColor: #3DD68C;
}

/* A ✓ with nothing to complete yet: outline and icon (disabledIconColor) fade together */
#timer_control_button:disabled {
    border-color: #1B1C1F;
}

/* Session rating (timer view during the break after a work session, duration view after
   Finish): small chips in the timer controls' style; the number turns tan on hover. */
#session_rating_prompt {
    color: #8C8E92;
    font-size: 12px;
}

#session_rating_button {
    background-color: transparent;
    color: #F5F1F1;
    border: 1px solid #2B2D31;
    border-radius: 10px;
    padding: 6px 0;
    font-weight: 700;
}

#session_rating_button:hover {
    color: #B89A72;
    border-color: #8C8E92;
}

#session_rating_button:pressed {
    background-color: #1B1C1F;
}

/* The small × beside the prompt that skips rating */
#session_rating_skip_button {
    background-color: transparent;
    border: 1px solid transparent; /* reserves the focus ring's width */
    border-radius: 6px;
    padding: 5px; /* with the 14 px icon, a 26 px target that's easy to hit */
    qproperty-iconColor: #8C8E92;
    qproperty-hoverIconColor: #8C8E92;
    qproperty-selectedIconColor: #8C8E92;
    qproperty-disabledIconColor: #2B2D31;
}

#session_rating_skip_button:hover {
    background-color: #1B1C1F;
}

/* Destructive actions (the all-time reset and its confirmation): red outline, so they never
   look like the everyday buttons around them. */
#destructive_button {
    color: #E5484D;
    border-color: #E5484D;
}

#destructive_button:hover {
    background-color: #1B1C1F;
}

#destructive_button:disabled {
    color: #8C8E92;
    border-color: #2B2D31;
}

#confirmation_dialog {
    background-color: #0F1012;
}

#confirmation_dialog_title {
    color: #E5484D;
    font-size: 16px;
    font-weight: 700;
}

QLineEdit {
    background-color: #0A0A0A;
    border: 1px solid #2B2D31;
    border-radius: 8px;
    padding: 6px 10px;
    selection-background-color: #B89A72;
    selection-color: #0A0A0A;
}

QLineEdit:focus {
    border-color: #B89A72;
}

QCheckBox {
    spacing: 10px;
}

QCheckBox:focus {
    color: #B89A72;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #8C8E92;
    border-radius: 4px;
    background-color: #0F1012;
}

QCheckBox::indicator:checked {
    background-color: #B89A72;
    border-color: #B89A72;
}

/* Keyboard focus (Ctrl+Tab): tan ring. Last in the file so it beats
   equally specific states like :checked.
   Only TabFocus controls get focus, so clicks never show it. */
#profile_corner_button:focus,
#info_button:focus,
#settings_shortcuts_button:focus,
#timer_control_button:focus,
#session_rating_button:focus,
#session_rating_skip_button:focus,
QPushButton:focus {
    border-color: #B89A72;
}

/* Two ids beat "#destructive_button" above. Profile's all-time reset shows focus as a shaded
   red fill with its red outline kept (a tan ring would read as an everyday button); the
   confirmation dialog's Reset keeps the tan ring. */
#callout_card #destructive_button:focus {
    border-color: #E5484D;
    background-color: rgba(229, 72, 77, 0.18);
}

#confirmation_dialog #destructive_button:focus {
    border-color: #B89A72;
}
